<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PaginasResponsive.MainPage"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="None"
             BackgroundColor="{DynamicResource fondo_pantalla}">
    <Grid Padding="24" SafeAreaEdges="None">
        <Label Text="{DynamicResource Saludo}"
               TextColor="{DynamicResource texto_saludo}"
               HorizontalOptions="Fill" VerticalOptions="Fill"
               HorizontalTextAlignment="Center" VerticalTextAlignment="Center">
            <!-- Omite la fuente y el tamaño del estilo implícito de la plantilla. -->
            <Label.Style>
                <Style TargetType="Label" />
            </Label.Style>
        </Label>
    </Grid>
</ContentPage>
