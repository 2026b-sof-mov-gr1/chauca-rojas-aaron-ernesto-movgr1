<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoMovB1.Controls.Encabezado">

    <!-- Barra superior: flecha atrás | título | carrito (opcional) -->
    <Grid ColumnDefinitions="52,*,52" HeightRequest="60" Padding="8,0">
        <ImageButton Grid.Column="0"
                     Source="ic_atras.png"
                     WidthRequest="44" HeightRequest="44" Padding="9"
                     BackgroundColor="Transparent"
                     SemanticProperties.Description="Regresar"
                     Clicked="OnAtrasClicked" />

        <Label x:Name="TituloLabel"
               Grid.Column="1"
               Style="{StaticResource TituloPagina}" />

        <ImageButton x:Name="CarritoButton"
                     Grid.Column="2"
                     Source="ic_carrito.png"
                     WidthRequest="44" HeightRequest="44" Padding="6"
                     BackgroundColor="Transparent"
                     IsVisible="False"
                     SemanticProperties.Description="Ver carrito"
                     Clicked="OnCarritoClicked" />
    </Grid>
</ContentView>
