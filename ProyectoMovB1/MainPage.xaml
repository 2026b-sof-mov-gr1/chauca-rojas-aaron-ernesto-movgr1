<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ProyectoMovB1.Controls"
             x:Class="ProyectoMovB1.MainPage"
             Title="Inicio">

    <Grid RowDefinitions="*,Auto">

        <!-- Onda decorativa al fondo (detrás del contenido) -->
        <controls:OndaInferior Grid.Row="0" Grid.RowSpan="2" />

        <VerticalStackLayout Grid.Row="0"
                             Padding="24,40,24,0"
                             Spacing="36"
                             MaximumWidthRequest="480">

            <!-- Logo -->
            <Image Source="logo_shortline.png"
                   HeightRequest="230"
                   Aspect="AspectFit"
                   SemanticProperties.Description="Logo Short Line EPN" />

            <!-- Accesos principales -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="18">

                <Border Grid.Column="0" Style="{StaticResource TarjetaBlanca}" HeightRequest="150">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVerPedidosTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="10">
                        <Image Source="ic_pedidos.png" HeightRequest="48" />
                        <Label Text="Ver&#10;pedidos"
                               FontSize="18" TextColor="{StaticResource TextoOscuro}"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource TarjetaBlanca}" HeightRequest="150">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnComprarTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="14">
                        <Image Source="ic_cubiertos.png" HeightRequest="48" />
                        <Label Text="Comprar"
                               FontSize="18" TextColor="{StaticResource TextoOscuro}"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>

        <!-- Ajustes / Mi cuenta -->
        <ImageButton Grid.Row="1"
                     Source="ic_ajustes.png"
                     HorizontalOptions="End"
                     WidthRequest="48" HeightRequest="48" Padding="8"
                     Margin="0,0,24,120"
                     BackgroundColor="Transparent"
                     SemanticProperties.Description="Mi cuenta"
                     Clicked="OnAjustesClicked" />
    </Grid>
</ContentPage>
